@{
    ViewData["Title"] = "Home";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet">

<style>
    body {
        background-color: #F8F4EE;
        font-family: 'Poppins', sans-serif;
        color: #2B2B2B;
    }

    .hero-section {
        min-height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(rgba(0,0,0,0.42), rgba(0,0,0,0.42)), url('https://wallpapercave.com/wp/WzPRsaF.jpg');
        background-size: cover;
        background-position: center;
        border-radius: 30px;
        margin-top: 30px;
        padding: 60px;
        overflow: hidden;
    }

    .hero-content {
        text-align: center;
        color: white;
        max-width: 780px;
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 6rem;
        line-height: 1.05;
        font-weight: 700;
        margin-bottom: 25px;
        letter-spacing: 2px;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        margin-bottom: 40px;
        color: #f3f3f3;
    }

    .luxury-btn {
        padding: 14px 36px;
        border-radius: 50px;
        font-size: 1rem;
        font-weight: 500;
        transition: 0.3s ease;
        margin: 10px;
        text-decoration: none;
    }

    .btn-gold {
        background-color: #C6A969;
        color: white;
        border: none;
    }

        .btn-gold:hover {
            background-color: #b59656;
            color: white;
            transform: translateY(-3px);
        }

    .btn-light-luxury {
        border: 2px solid white;
        color: white;
    }

        .btn-light-luxury:hover {
            background-color: white;
            color: #2B2B2B;
            transform: translateY(-3px);
        }

    .luxury-section {
        padding: 100px 0;
    }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        margin-bottom: 15px;
        text-align: center;
    }

    .section-subtitle {
        text-align: center;
        max-width: 650px;
        margin: 0 auto 55px;
        color: #6d6258;
    }

    .category-card {
        background: #ffffff;
        border-radius: 26px;
        overflow: hidden;
        transition: 0.35s ease;
        box-shadow: 0 18px 45px rgba(0,0,0,0.08);
        height: 100%;
    }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 60px rgba(0,0,0,0.13);
        }

        .category-card img {
            height: 360px;
            object-fit: cover;
            transition: 0.5s ease;
        }

        .category-card:hover img {
            transform: scale(1.06);
        }

    .card-body-custom {
        padding: 28px;
        text-align: center;
    }

    .category-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.9rem;
        margin-bottom: 10px;
    }

    .category-text {
        color: #6d6258;
        margin-bottom: 0;
    }

    .feature-box {
        background: rgba(255,255,255,0.65);
        border: 1px solid rgba(198,169,105,0.25);
        border-radius: 24px;
        text-align: center;
        padding: 38px 28px;
        height: 100%;
        transition: 0.3s ease;
    }

        .feature-box:hover {
            background: white;
            transform: translateY(-6px);
            box-shadow: 0 18px 45px rgba(0,0,0,0.08);
        }

    .feature-icon {
        font-size: 2.8rem;
        color: #C6A969;
        margin-bottom: 20px;
    }

    .feature-title {
        font-size: 1.35rem;
        font-weight: 600;
        margin-bottom: 14px;
    }

    .feature-text {
        color: #6d6258;
        margin-bottom: 0;
    }

    .boutique-banner {
        background: #2B2B2B;
        color: white;
        border-radius: 28px;
        padding: 70px 40px;
        text-align: center;
        margin-bottom: 80px;
    }

        .boutique-banner h2 {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            margin-bottom: 18px;
        }

        .boutique-banner p {
            color: #ddd;
            max-width: 650px;
            margin: 0 auto 30px;
        }

    @@media (max-width: 768px) {
        .hero-section {
            min-height: 75vh;
            padding: 35px 20px;
            border-radius: 22px;
        }

        .hero-title {
            font-size: 3.2rem;
        }

        .section-title {
            font-size: 2.3rem;
        }

        .category-card img {
            height: 300px;
        }
    }
</style>

<div class="container">

    <section class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">
                Rent Designer Fashion
            </h1>

            <p class="hero-subtitle">
                Premium boutique rentals for elegant evenings, special occasions
                and unforgettable moments.
            </p>

            <div>
                <a asp-controller="FashionItems"
                   asp-action="Index"
                   class="btn luxury-btn btn-gold">
                    Browse Collection
                </a>

                @if (Context.Session.GetString("JWT") == null)
                {
                    <a asp-controller="Auth"
                       asp-action="Register"
                       class="btn luxury-btn btn-light-luxury">
                        Become a Member
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="luxury-section">

        <h2 class="section-title">
            Curated Boutique Collection
        </h2>

        <p class="section-subtitle">
            Discover refined pieces selected for weddings, galas, celebrations
            and premium everyday elegance.
        </p>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="category-card">
                    <img src="https://myquickurl.com/cheerlives.com/8-cheerlives_20241214085722.webp"
                         class="w-100"
                         alt="Luxury Dresses" />

                    <div class="card-body-custom">
                        <h3 class="category-title">
                            Dresses
                        </h3>

                        <p class="category-text">
                            Evening gowns and elegant statement pieces.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="category-card">
                    <img src="https://i.pinimg.com/originals/70/d4/5e/70d45ef8c7b0bc58c9b36169baabe56a.jpg"
                         class="w-100"
                         alt="Premium Suits" />

                    <div class="card-body-custom">
                        <h3 class="category-title">
                            Suits
                        </h3>

                        <p class="category-text">
                            Tailored looks for refined modern style.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="category-card">
                    <img src="https://images.unsplash.com/photo-1617038220319-276d3cfab638?q=80&w=1974&auto=format&fit=crop"
                         class="w-100"
                         alt="Luxury Accessories" />

                    <div class="card-body-custom">
                        <h3 class="category-title">
                            Accessories
                        </h3>

                        <p class="category-text">
                            Bags, jewelry and finishing touches.
                        </p>
                    </div>
                </div>
            </div>

        </div>

    </section>

    <div class="boutique-banner">
        <h2>
            Luxury Without Commitment
        </h2>

        <p>
            Enjoy premium fashion for every occasion without buying pieces
            you may wear only once.
        </p>

        <a asp-controller="FashionItems"
           asp-action="Index"
           class="btn luxury-btn btn-gold">
            Start Renting
        </a>
    </div>

    <section class="luxury-section pt-0">

        <h2 class="section-title">
            Why Choose Us
        </h2>

        <p class="section-subtitle">
            A smoother, smarter and more sustainable way to experience fashion.
        </p>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon">
                        ✨
                    </div>

                    <h4 class="feature-title">
                        Premium Selection
                    </h4>

                    <p class="feature-text">
                        Carefully selected luxury fashion pieces for every event.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon">
                        🚚
                    </div>

                    <h4 class="feature-title">
                        Easy Renting
                    </h4>

                    <p class="feature-text">
                        Simple booking process with fast and secure delivery.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon">
                        ♻️
                    </div>

                    <h4 class="feature-title">
                        Sustainable Style
                    </h4>

                    <p class="feature-text">
                        Wear more, waste less and support circular fashion.
                    </p>
                </div>
            </div>

        </div>

    </section>

</div>