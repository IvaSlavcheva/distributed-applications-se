@model FashionSystem.Web.Models.User.CreateUserDto

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-body">

                    <h2 class="mb-4 text-center">
                        Register
                    </h2>

                    <form asp-action="Register">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                First Name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Last Name
                            </label>

                            <input asp-for="LastName"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Phone Number
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control" />
                        </div>

                        <button class="btn btn-dark w-100">
                            Register
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>