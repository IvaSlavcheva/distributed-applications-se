@model FashionSystem.Web.Models.FashionItem.GetFashionItemDto

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-body">

            <h2 class="text-danger">
                Delete Fashion Item
            </h2>

            <hr />

            <h4>
                Are you sure you want to delete:
            </h4>

            <h3>
                @Model.Name
            </h3>

            <form asp-action="Delete">

                <button class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>