@model FashionSystem.Web.Models.PagedResult<FashionSystem.Web.Models.FashionItem.GetFashionItemDto>

@{
    ViewData["Title"] = "Fashion Collection";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet">

<style>

    body {
        background: #F8F4EE;
        font-family: 'Poppins', sans-serif;
        color: #2B2B2B;
    }

    .catalog-hero {
        background: linear-gradient(rgba(43,43,43,0.55), rgba(43,43,43,0.55)), url('/images/hh.png');
        background-size: cover;
        background-position: center;
        border-radius: 32px;
        padding: 90px 30px;
        text-align: center;
        color: white;
        margin-bottom: 45px;
    }

        .catalog-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 4.8rem;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .catalog-hero p {
            max-width: 650px;
            margin: 0 auto;
            color: #f3f3f3;
            font-size: 1.1rem;
        }

    .filter-panel {
        background: rgba(255,255,255,0.75);
        border: 1px solid rgba(198,169,105,0.25);
        border-radius: 26px;
        padding: 24px;
        margin-bottom: 45px;
        box-shadow: 0 18px 45px rgba(0,0,0,0.07);
        backdrop-filter: blur(12px);
    }

    .form-control,
    .form-select {
        border-radius: 50px;
        border: 1px solid #e5d6bd;
        padding: 13px 18px;
        background-color: #fffaf4;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #C6A969;
            box-shadow: 0 0 0 0.16rem rgba(198,169,105,0.22);
        }

    .luxury-btn {
        border-radius: 50px;
        padding: 10px 18px;
        font-weight: 500;
        transition: 0.3s ease;
        text-decoration: none;
        font-size: 0.88rem;
    }

    .btn-gold {
        background: #C6A969;
        color: white;
        border: none;
    }

        .btn-gold:hover {
            background: #b59656;
            color: white;
            transform: translateY(-2px);
        }

    .btn-dark-luxury {
        background: #2B2B2B;
        color: white;
        border: none;
    }

        .btn-dark-luxury:hover {
            background: black;
            color: white;
            transform: translateY(-2px);
        }

    .btn-outline-luxury {
        border: 1px solid #C6A969;
        color: #9c7d3f;
        background: transparent;
    }

        .btn-outline-luxury:hover {
            background: #C6A969;
            color: white;
        }

    .product-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(198,169,105,0.18);
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        transition: 0.35s ease;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .product-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 22px 45px rgba(0,0,0,0.14);
        }

    .product-image-box {
        position: relative;
        overflow: hidden;
        background: #eee3d4;
        height: 340px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: 0.55s ease;
        filter: brightness(0.96);
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .status-pill {
        position: absolute;
        top: 14px;
        right: 14px;
        border-radius: 50px;
        padding: 6px 12px;
        font-size: 0.72rem;
        font-weight: 600;
        backdrop-filter: blur(8px);
        z-index: 5;
    }

    .available {
        background: rgba(216,243,220,0.9);
        color: #245b41;
    }

    .rented {
        background: rgba(255,229,229,0.9);
        color: #9b1c2c;
    }

    .product-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .product-name {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        line-height: 1.2;
        margin-bottom: 6px;
    }

    .designer {
        color: #C6A969;
        font-weight: 600;
        margin-bottom: 12px;
        font-size: 0.95rem;
    }

    .meta {
        color: #70655b;
        font-size: 0.92rem;
        margin-bottom: 4px;
    }

    .price-row {
        margin-top: 14px;
        margin-bottom: 16px;
        padding-top: 14px;
        border-top: 1px solid #eee2d2;
    }

    .price {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .per-day {
        font-size: 0.8rem;
        color: #8a7b6b;
    }

    .actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: auto;
    }

        .actions .btn,
        .actions form {
            flex: 1;
        }

        .actions button,
        .actions a {
            width: 100%;
        }

    .empty-state {
        background: white;
        border-radius: 28px;
        padding: 60px;
        text-align: center;
        box-shadow: 0 18px 45px rgba(0,0,0,0.08);
    }

    @@media (max-width: 768px) {

        .catalog-hero h1 {
            font-size: 3rem;
        }

        .catalog-hero {
            padding: 65px 20px;
        }

        .product-image-box {
            height: 250px;
        }
    }

</style>

<div class="container py-5">

    <section class="catalog-hero">

        <h1>Luxury Collection</h1>

        <p>
            Discover curated designer fashion pieces available for rent.
            Elegant style, premium quality and unforgettable presence.
        </p>

    </section>

    <div class="filter-panel">

        <form method="get" class="row g-3 align-items-center">

            <div class="col-lg-3 col-md-6">

                <input name="designer"
                       class="form-control"
                       placeholder="Search by designer" />

            </div>

            <div class="col-lg-3 col-md-6">

                <input name="category"
                       class="form-control"
                       placeholder="Search by category" />

            </div>

            <div class="col-lg-3 col-md-6">

                <select name="sortBy" class="form-select">

                    <option value="">Sort collection</option>

                    <option value="price">Price</option>

                    <option value="designer">Designer</option>

                    <option value="date">Newest</option>

                </select>

            </div>

            <div class="col-lg-3 col-md-6">

                <button class="btn btn-gold luxury-btn w-100">
                    Search
                </button>

            </div>

        </form>

    </div>

    @if (Context.Session.GetString("Role") == "Admin")
    {
        <div class="d-flex justify-content-end mb-4">

            <a asp-action="Create"
               class="btn btn-dark-luxury luxury-btn">

                + Create Fashion Item

            </a>

        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="empty-state">

            <h3>No fashion items found</h3>

            <p class="text-muted mb-0">
                Try changing your search or filters.
            </p>

        </div>
    }
    else
    {
        <div class="row align-items-stretch g-4">

            @foreach (var item in Model.Items)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 d-flex">

                    <div class="product-card">

                        <div class="product-image-box">

                            <img src="@item.ImageUrl"
                                 class="product-image"
                                 alt="@item.Name" />

                            @if (item.IsAvailable)
                            {
                                <span class="status-pill available">
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="status-pill rented">
                                    Rented
                                </span>
                            }

                        </div>

                        <div class="product-body">

                            <h3 class="product-name">
                                @item.Name
                            </h3>

                            <div class="designer">
                                @item.Designer
                            </div>

                            <div class="meta">
                                <strong>Category:</strong> @item.Category
                            </div>

                            <div class="meta">
                                <strong>Style:</strong> @item.Style
                            </div>

                            <div class="price-row">

                                <div class="price">
                                    $@item.PricePerDay
                                </div>

                                <div class="per-day">
                                    per day
                                </div>

                            </div>

                            <div class="actions">

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-luxury luxury-btn">

                                    Details

                                </a>

                                @if (
                                                        Context.Session.GetString("JWT") != null
                                                        &&
                                                        Context.Session.GetString("Role") != "Admin"
                                                        &&
                                                        item.IsAvailable)
                                {
                                    <a asp-controller="Rentals"
                                       asp-action="Rent"
                                       asp-route-id="@item.Id"
                                       class="btn btn-gold luxury-btn">

                                        Rent

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

        <nav class="mt-5">
            <ul class="pagination justify-content-center">

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-designer="@Context.Request.Query["designer"]"
                           asp-route-category="@Context.Request.Query["category"]"
                           asp-route-sortBy="@Context.Request.Query["sortBy"]">
                            @i
                        </a>
                    </li>
                }

            </ul>
        </nav>
    }

</div>